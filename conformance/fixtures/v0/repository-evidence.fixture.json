    },
    {
      "path": "Makefile",
      "content": "test build:\n\t@echo inert\n\ndanger:\n\t@touch SHOULD_NOT_EXIST\n\n$(eval $(shell touch SHOULD_NOT_EXIST))\n"
    },
    {
      "path": "package.json",
      "content": "{\n  \"name\": \"fixture\",\n  \"packageManager\": \"pnpm@11.18.0\",\n  \"engines\": { \"node\": \"^24.11.0\" },\n  \"scripts\": {\n    \"test\": \"node -e \\\"require('node:fs').writeFileSync('SHOULD_NOT_EXIST','x')\\\"\",\n    \"substitute\": \"echo $(touch SHOULD_NOT_EXIST) `touch SHOULD_NOT_EXIST`\"\n  },\n  \"devDependencies\": { \"eslint\": \"10.0.1\", \"prettier\": \"3.9.6\" },\n  \"workspaces\": [\"packages/*\"]\n}\n"
    },
    { "path": "package-lock.json", "content": "{}\n" },
