{
  "name": "agent-context-linter-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^24.11.0 || ^26.0.0",
    "pnpm": "11.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "action:build": "node scripts/build-github-action.mjs --write",
    "action:check": "node scripts/build-github-action.mjs --check",
    "boundaries": "node scripts/check-package-boundaries.mjs",
    "build": "tsc -b --pretty false && node scripts/build-cli-bundle.mjs --write",
    "check": "pnpm format:check && pnpm compatibility:reference:check && pnpm config:reference:check && pnpm cli:docs:check && pnpm action:check && pnpm lint && pnpm feature-flags:check && pnpm ci:validate && pnpm security:validate && pnpm conformance:validate && pnpm rules:docs:check && pnpm licenses:check && pnpm release:check && pnpm test && pnpm test:determinism && pnpm coverage && pnpm typecheck && pnpm pack:check",
    "changeset": "changeset",
    "cli:docs": "node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-cli-documentation.mjs --write",
    "cli:docs:check": "node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-cli-documentation.mjs",
    "cli:bundle": "node scripts/build-cli-bundle.mjs --write",
    "cli:bundle:check": "node scripts/build-cli-bundle.mjs --check",
    "ci:validate": "node scripts/check-local-policy.mjs && node scripts/check-action-metadata.mjs",
    "clean": "tsc -b --clean",
    "compatibility:reference": "tsc -b --pretty false && node scripts/generate-compatibility-policy.mjs --write",
    "compatibility:reference:check": "tsc -b --pretty false && node scripts/generate-compatibility-policy.mjs --check",
    "conformance:official:generate": "node tools/conformance/generate-official-example-corpus.mjs --write --acknowledge-reviewed-update",
    "conformance:official:validate": "node tools/conformance/generate-official-example-corpus.mjs --check && node tools/conformance/validate-official-example-corpus.mjs conformance/official-examples/v0/corpus.json",
    "conformance:validate": "node tools/conformance/validate-profile-contract.mjs conformance/contracts/profile-surface-map.v0.json conformance/fixtures/v0/codex-root-order.fixture.json conformance/fixtures/v0/claude-launch-read-rules.fixture.json conformance/fixtures/v0/copilot-cli-order-unknown.fixture.json conformance/fixtures/v0/copilot-vscode-description-ambiguity.fixture.json conformance/fixtures/v0/cursor-cli-cross-format-order-unknown.fixture.json conformance/fixtures/v0/cursor-ide-model-selection-unknown.fixture.json conformance/fixtures/v0/gemini-hierarchy-jit.fixture.json conformance/fixtures/v0/gemini-import-modes.fixture.json conformance/fixtures/v0/gemini-ignore-memory-ambiguity.fixture.json && node tools/conformance/validate-cursor-rule-facts.mjs docs/profiles/data/cursor-rule-facts.v0.json && pnpm conformance:gemini:validate && pnpm conformance:official:validate && pnpm sarif:compatibility",
    "conformance:gemini:validate": "node tools/conformance/validate-gemini-research.mjs docs/profiles/data/gemini-cli-context-facts.v0.json conformance/contracts/profile-surface-map.v0.json conformance/fixtures/v0/gemini-hierarchy-jit.fixture.json conformance/fixtures/v0/gemini-import-modes.fixture.json conformance/fixtures/v0/gemini-ignore-memory-ambiguity.fixture.json",
    "config:reference": "node scripts/generate-configuration-reference.mjs --write",
    "config:reference:check": "node scripts/generate-configuration-reference.mjs --check",
    "coverage": "node scripts/run-coverage-merge.mjs",
    "feature-flags:check": "node scripts/verify-feature-flags.mjs --mode development",
    "feature-flags:ga": "node scripts/verify-feature-flags.mjs --mode ga",
    "format": "prettier --write action/action.yml action/README.md \"action/src/**/*.mjs\" \"action/test/**/*.mjs\" eslint.config.mjs vitest.config.ts package.json pnpm-workspace.yaml CHANGELOG.md CONTRIBUTING.md README.md SECURITY.md SUPPORT.md \".changeset/*.{cjs,json,md}\" \"calibration/**/*.json\" \"config/**/*.json\" \"conformance/**/*.json\" \"docs/profiles/data/cursor-rule-facts*.json\" \"optional-tokenizers/**/*.json\" \"tsconfig*.json\" \"packages/**/*.{d.mts,json,mjs,ts}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.{json,mjs}\" \"docs/api/**/*.md\" \"docs/development/**/*.md\" \"docs/operations/**/*.md\" \"docs/rules/**/*.md\" docs/architecture/decisions/0005-closed-cli-scan-bundle.md docs/security/github-actions-integration.md docs/security/metadata-calibration.md docs/security/scan-command.md docs/security/standards-recovery.md docs/user/README.md docs/user/ci.md docs/user/migration.md docs/user/profiles.md docs/user/reviewing-metadata-calibration.md docs/user/scanning.md docs/user/standards.md",
    "format:check": "prettier --check action/action.yml action/README.md \"action/src/**/*.mjs\" \"action/test/**/*.mjs\" eslint.config.mjs vitest.config.ts package.json pnpm-workspace.yaml CHANGELOG.md CONTRIBUTING.md README.md SECURITY.md SUPPORT.md \".changeset/*.{cjs,json,md}\" \"calibration/**/*.json\" \"config/**/*.json\" \"conformance/**/*.json\" \"docs/profiles/data/cursor-rule-facts*.json\" \"optional-tokenizers/**/*.json\" \"tsconfig*.json\" \"packages/**/*.{d.mts,json,mjs,ts}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.{json,mjs}\" \"docs/api/**/*.md\" \"docs/development/**/*.md\" \"docs/operations/**/*.md\" \"docs/rules/**/*.md\" docs/architecture/decisions/0005-closed-cli-scan-bundle.md docs/security/github-actions-integration.md docs/security/metadata-calibration.md docs/security/scan-command.md docs/security/standards-recovery.md docs/user/README.md docs/user/ci.md docs/user/migration.md docs/user/profiles.md docs/user/reviewing-metadata-calibration.md docs/user/scanning.md docs/user/standards.md",
    "lint": "eslint eslint.config.mjs vitest.config.ts \"action/src/**/*.mjs\" \"action/test/**/*.mjs\" \"packages/**/*.ts\" \"packages/**/*.mjs\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"tools/**/*.mjs\" && pnpm boundaries",
    "licenses:check": "node scripts/check-project-license.mjs && node scripts/check-dependency-licenses.mjs",
    "metadata-calibration:check": "node tools/metadata-calibration/run.mjs",
    "metadata-calibration:capture": "node tools/metadata-calibration/execute.mjs",
    "metadata-calibration:cleanup": "node tools/metadata-calibration/cleanup.mjs",
    "metadata-calibration:precision:check": "node tools/metadata-calibration/gate.mjs",
    "metadata-calibration:precision:release": "node tools/metadata-calibration/gate-state.mjs --release",
    "metadata-calibration:quota:native": "node tools/metadata-calibration/quota-native.mjs",
    "metadata-calibration:generate": "node tools/metadata-calibration/discover.mjs --write --acknowledge-reviewed-update",
    "pack:check": "node scripts/check-packed-manifests.mjs",
    "pack:install-matrix": "node scripts/check-package-install-matrix.mjs --strict",
    "pack:install-matrix:evidence": "node scripts/package-install-matrix-evidence.mjs",
    "release:check": "node scripts/check-release-policy.mjs",
    "release:artifacts:generate": "node scripts/release-artifacts.mjs generate",
    "release:artifacts:verify": "node scripts/release-artifacts.mjs verify",
    "release:soak": "node scripts/release-soak.mjs run",
    "release:evidence:monitor": "node scripts/release-evidence.mjs monitor",
    "release:evidence:retrospective": "node scripts/release-evidence.mjs retrospective",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "docs:artifacts": "node scripts/generate-configuration-reference.mjs --write && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-rule-catalog.mjs --write && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-cli-documentation.mjs --write",
    "docs:artifacts:check": "node scripts/generate-configuration-reference.mjs && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-rule-catalog.mjs && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-cli-documentation.mjs",
    "docs:coverage:check": "node scripts/check-documentation-coverage.mjs",
    "rules:docs": "pnpm build && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-rule-catalog.mjs --write",
    "rules:docs:check": "node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs scripts/generate-rule-catalog.mjs --check",
    "rules:scheduler:golden": "pnpm build && vitest run tests/rule-scheduler.integration.test.ts --project integration --update",
    "seeded-recall:check": "pnpm build && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs ./tools/seeded-recall/run.mjs",
    "seeded-recall:generate": "pnpm build && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs ./tools/seeded-recall/run.mjs --write --acknowledge-reviewed-update",
    "sarif:compatibility": "node scripts/check-sarif-oasis-subset.mjs",
    "security:validate": "node scripts/check-security-controls.mjs && node tools/standards/validate-maintainer-workflow.mjs && node tools/standards/validate-standards-proposal-workflow.mjs",
    "standards:recovery-drill": "vitest run packages/standards/test/tuf-trust.unit.test.ts && node tools/standards/recovery-tabletop.mjs",
    "standards:recovery-capture": "node tools/standards/capture-recovery-tabletop.mjs --acknowledge-execution",
    "standards:recovery:preflight": "node tools/standards/recovery-lock-preflight.mjs --text",
    "standards:recovery-prepare:a": "node tools/standards/prepare-recovery-runtime.mjs --acknowledge-network --slot=a",
    "standards:recovery-prepare:b": "node tools/standards/prepare-recovery-runtime.mjs --acknowledge-network --slot=b",
    "standards:recovery-review": "node tools/standards/review-recovery-preparations.mjs",
    "standards:recovery-build": "node tools/standards/build-recovery-runtime.mjs --acknowledge-offline-build",
    "standards:review": "node tools/standards/upstream-review.mjs generate",
    "standards:review:verify": "node tools/standards/upstream-review.mjs verify",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "hooks:uninstall": "node scripts/install-git-hooks.mjs --uninstall",
    "verify:local": "node scripts/run-local-gate.mjs",
    "standards:snapshot": "node tools/standards/upstream-snapshotter.mjs capture",
    "standards:snapshot:verify": "node tools/standards/upstream-snapshotter.mjs verify",
    "standards:weekly": "node tools/standards/local-weekly-check.mjs check",
    "standards:weekly:accept": "node tools/standards/local-weekly-check.mjs accept",
    "test": "pnpm test:boundaries && pnpm test:ci && pnpm test:coverage-runner && pnpm test:conformance && pnpm test:feature-flags && pnpm test:security && pnpm test:standards-tools && pnpm test:rules-docs && pnpm test:documentation && pnpm test:pack && pnpm test:seeded-recall && pnpm test:metadata-calibration && pnpm test:parallel",
    "test:boundaries": "node --test scripts/check-package-boundaries.test.mjs",
    "test:action-clean-install": "node scripts/test-github-action-clean-install.mjs",
    "test:ci": "node --test action/test/*.test.mjs scripts/build-github-action.test.mjs scripts/check-action-metadata.test.mjs scripts/check-local-policy.test.mjs scripts/run-local-gate.test.mjs scripts/run-vitest-suite.test.mjs scripts/test-github-action-clean-install.test.mjs",
    "test:conformance": "node --test tools/conformance/generate-official-example-corpus.test.mjs tools/conformance/real-client-observation.test.mjs tools/conformance/validate-ga-profile-observations.test.mjs tools/conformance/validate-official-example-corpus.test.mjs tools/conformance/validate-profile-contract.test.mjs tools/conformance/validate-cursor-rule-facts.test.mjs tools/conformance/validate-gemini-research.test.mjs",
    "test:coverage-runner": "node --test scripts/run-coverage-merge.test.mjs",
    "test:determinism": "node scripts/verify-test-determinism.mjs",
    "test:documentation": "node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs --test scripts/check-documentation-coverage.test.mjs scripts/check-documentation-examples.test.mjs scripts/check-documentation-links.test.mjs scripts/check-public-documentation.test.mjs scripts/check-release-policy.test.mjs scripts/check-review-governance.test.mjs scripts/generate-cli-documentation.test.mjs",
    "test:release-evidence": "node --test scripts/release-evidence.test.mjs",
    "docs:links:check": "node scripts/check-documentation-links.mjs",
    "test:feature-flags": "node --test scripts/verify-feature-flags.test.mjs",
    "test:fuzz": "tsc -b --pretty false && vitest run tests/fuzz/parser-surfaces.integration.test.ts",
    "test:integration": "vitest run --project integration",
    "test:metadata-calibration": "node --test tools/metadata-calibration/*.test.mjs && node tools/metadata-calibration/run.mjs && node tools/metadata-calibration/gate-state.mjs",
    "test:package-install-matrix": "node --test scripts/check-package-install-matrix.test.mjs scripts/package-install-matrix-evidence.test.mjs",
    "test:parallel": "node scripts/run-vitest-suite.mjs",
    "test:pack": "pnpm build && node --test scripts/build-cli-bundle.test.mjs scripts/check-packed-manifests.test.mjs",
    "test:rules-docs": "node --test scripts/generate-rule-catalog.test.mjs",
    "test:security": "node --test scripts/adjudicate-secret-scan.test.mjs scripts/check-dependency-licenses.test.mjs scripts/check-project-license.test.mjs scripts/check-security-controls.test.mjs",
    "test:seeded-recall": "pnpm build && node --test tools/seeded-recall/contracts.test.mjs && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs --test tools/seeded-recall/run.test.mjs && node --experimental-strip-types --import ./tools/seeded-recall/typescript-loader.mjs ./tools/seeded-recall/run.mjs",
    "test:standards-tools": "node --test tools/standards/local-weekly-check.test.mjs tools/standards/maintainer-review-bundle.test.mjs tools/standards/recovery-lock-preflight.test.mjs tools/standards/standards-update-proposal.test.mjs tools/standards/upstream-review.test.mjs tools/standards/upstream-snapshotter.test.mjs tools/standards/validate-maintainer-workflow.test.mjs tools/standards/validate-standards-proposal-workflow.test.mjs",
    "test:serial": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "spdx-expression-parse": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
