      },
      {
        "id": "mixed-newlines-unicode",
        "text": "# café\r\n- 日本語\r- 🧭\n"
      }
    ],
    "paths": [
      { "flavor": "posix", "id": "parent-traversal", "input": "a/../../escape" },
      { "flavor": "win32", "id": "device-namespace", "input": "\\\\?\\C:\\escape" },
      { "flavor": "win32", "id": "drive-relative", "input": "C:relative\\file" },
      { "flavor": "posix", "id": "terminal-control", "input": "safe/\u001b[31m" },
