    "ignore": [
      {
        "id": "globstar-negation-parent",
        "paths": ["build/keep.txt", "build/out.bin", "src/index.ts"],
        "patterns": ["build/", "!build/keep.txt"]
      },
      {
        "id": "metacharacter-pressure",
        "paths": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt", "safe.txt"],
        "patterns": ["*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*a*b"]
      },
      {
        "id": "escaped-and-unicode",
        "paths": ["#literal", "café/🧭.md", "space name.md"],
        "patterns": ["\\#literal", "caf?/?.md", "space\\ name.md"]
      }
    ],
    "imports": [
      {
        "id": "fence-comment-and-live-import",
        "syntax": "claude-code",
        "text": "```md\n@hidden.md\n```\n<!-- @also-hidden.md -->\n@live.md\n"
      },
      {
        "id": "bidi-and-terminal-adjacent",
        "syntax": "gemini-cli",
        "text": "@safe.md\u001b[31m\u202e\n"
      },
      {
        "id": "import-malformed-unicode",
        "syntax": "cursor-agent",
        "text": "@broken-\ud800.md"
      }
    ],
    "markdown": [
      {
        "id": "unclosed-fence",
        "text": "# heading\n```ts\nconst value = 1;\n"
      },
      {
        "id": "adversarial-html-comment",
        "text": "before\n<!-- <!-- <!-- never closes\n@not-an-import.md\n"
      },
      {
        "id": "controls-bidi-and-surrogate",
