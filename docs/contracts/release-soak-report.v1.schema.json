{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context.invalid/schemas/release-soak-report.v1.schema.json",
  "title": "Agent Context Linter local release-soak rehearsal report",
  "description": "Bounded offline candidate/rollback smoke evidence. This is not seven-day soak or publication evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifactFormat",
    "schemaVersion",
    "status",
    "harness",
    "runtime",
    "candidate",
    "previous",
    "findings",
    "blockingFindings",
    "rollbackVerified",
    "phases",
    "workspace",
    "limits"
  ],
  "properties": {
    "$schema": {
      "const": "https://agent-context.invalid/schemas/release-soak-report.v1.schema.json"
    },
    "artifactFormat": { "const": "agent-context-release-soak-rehearsal-v1" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["passed", "failed-p1", "blocked-p0-p1"] },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "commandTimeoutMs",
        "totalTimeoutMs",
        "smokeCases",
        "networkPolicy",
        "processPolicy",
        "repositoryMutation"
      ],
      "properties": {
        "iterations": { "type": "integer", "minimum": 1, "maximum": 32 },
        "commandTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "totalTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "smokeCases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "output"],
            "properties": {
              "id": { "enum": ["help", "list-json", "scan-json"] },
              "output": { "enum": ["text", "json"] }
            }
          }
        },
        "networkPolicy": { "const": "deny-preload" },
        "processPolicy": { "const": "deny-preload" },
        "repositoryMutation": { "const": "detected-by-workspace-digest" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "platform", "arch"],
      "properties": {
        "node": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "candidate": { "$ref": "#/$defs/artifact" },
    "previous": { "$ref": "#/$defs/artifact" },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/finding" }
    },
    "blockingFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/blockingFinding" }
    },
    "rollbackVerified": { "type": "boolean" },
    "phases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "outcomes", "blockingFindings", "deadlineExceeded"],
        "properties": {
          "phase": { "enum": ["candidate", "rollback"] },
          "skipped": { "const": "workspace-mutated" },
          "deadlineExceeded": { "type": "boolean" },
          "blockingFindings": {
            "type": "array",
            "items": { "$ref": "#/$defs/blockingFinding" }
          },
          "outcomes": {
            "type": "array",
            "items": { "$ref": "#/$defs/outcome" }
          }
        }
      }
    },
    "workspace": { "$ref": "#/$defs/tree" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIterations", "maxOutputBytes", "maxReportBytes", "maxTotalTimeoutMs"],
      "properties": {
        "maxIterations": { "const": 32 },
        "maxOutputBytes": { "const": 65536 },
        "maxReportBytes": { "type": "integer", "minimum": 65536, "maximum": 524288 },
        "maxTotalTimeoutMs": { "const": 300000 }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "artifactSha256",
        "artifactFiles",
        "artifactBytes",
        "cliSha256",
        "cliBytes"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifactFiles": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "artifactBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "cliSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cliBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "owner", "dueDate", "rationaleSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["open", "accepted"] },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "rationaleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "blockingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "severity": { "enum": ["P0", "P1"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "case",
        "exitCode",
        "signal",
        "outputLimit",
        "timedOut",
        "invalidOutput",
        "spawnError",
        "stdoutBytes",
        "stdoutSha256",
        "stderrBytes",
        "stderrSha256"
      ],
      "properties": {
        "iteration": { "type": "integer", "minimum": 1, "maximum": 32 },
        "case": { "enum": ["help", "list-json", "scan-json"] },
        "exitCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "signal": { "type": ["string", "null"], "maxLength": 32 },
        "outputLimit": { "type": "boolean" },
        "timedOut": { "type": "boolean" },
        "invalidOutput": { "type": "boolean" },
        "spawnError": { "type": ["string", "null"], "maxLength": 32 },
        "stdoutBytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "stdoutSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderrBytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "stderrSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "skipped": { "const": "total-deadline" }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes", "sha256"],
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
