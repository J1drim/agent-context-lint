{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/efficiency/efficiency-score-specification.v1.schema.json",
  "title": "Agent Context Linter efficiency score specification v1",
  "description": "Closed, data-only description of the version 1 context-efficiency formula.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "arithmetic",
    "budgets",
    "components",
    "configurationVersion",
    "contractVersion",
    "gradeThresholds",
    "qualityClaim",
    "recordKind",
    "scoreVersion"
  ],
  "properties": {
    "recordKind": { "const": "agent-context-efficiency-score-specification" },
    "contractVersion": { "const": "0.1.0" },
    "configurationVersion": { "const": 1 },
    "scoreVersion": { "const": "1.0.0" },
    "qualityClaim": { "const": false },
    "arithmetic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregateFormula",
        "componentFormula",
        "gradeBoundary",
        "integerImplementation",
        "ratioRounding",
        "scoreBasisPoints"
      ],
      "properties": {
        "aggregateFormula": {
          "const": "round-half-up(sum(componentScoreBasisPoints*weight)/10000)"
        },
        "componentFormula": {
          "const": "10000-round-half-up(sum(penaltyBasisPoints*allocation)/10000)"
        },
        "gradeBoundary": { "const": "inclusive-lower-bound" },
        "integerImplementation": { "const": "bigint" },
        "ratioRounding": { "const": "round-half-up" },
        "scoreBasisPoints": { "const": 10000 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alwaysOnTokens", "effectiveP95Tokens", "zeroBudgetPolicy"],
      "properties": {
        "alwaysOnTokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "effectiveP95Tokens": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "zeroBudgetPolicy": {
          "const": "zero-observed-is-zero-utilization-otherwise-saturate"
        }
      }
    },
    "gradeThresholds": {
      "description": "Runtime construction additionally requires A > B > C > D.",
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "$ref": "#/$defs/score" },
        "B": { "$ref": "#/$defs/score" },
        "C": { "$ref": "#/$defs/score" },
        "D": { "$ref": "#/$defs/score" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "basisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "weight"],
      "properties": {
        "id": {
          "enum": [
            "budgetFit",
            "scopePrecision",
            "nonRedundancy",
            "reachability",
            "instructionDensity",
            "crossAgentConsistency"
          ]
        },
        "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/input" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocationBasisPoints",
        "curve",
        "id",
        "metricSource",
        "normalization",
        "uncertaintyPolicy"
      ],
      "properties": {
        "allocationBasisPoints": { "$ref": "#/$defs/basisPoints" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "metricSource": { "type": "string", "minLength": 1, "maxLength": 512 },
        "normalization": {
          "enum": [
            "budget-utilization-v1",
            "broad-scope-token-share-v1",
            "cross-profile-divergence-rate-v1",
            "dead-scope-token-share-v1",
            "density-shortfall-v1",
            "duplicate-token-share-v1",
            "import-amplification-overhead-v1"
          ]
        },
        "uncertaintyPolicy": { "const": "required-complete-evidence" },
        "curve": { "$ref": "#/$defs/curve" }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputUnit", "interpolation", "outOfRange", "points"],
      "properties": {
        "id": { "type": "string", "pattern": "^efficiency:[a-z0-9]+(?:-[a-z0-9]+)*:v1$" },
        "inputUnit": { "const": "basis-points" },
        "interpolation": { "const": "piecewise-linear-round-half-up-v1" },
        "outOfRange": { "const": "clamp-to-endpoints" },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputBasisPoints", "penaltyBasisPoints"],
            "properties": {
              "inputBasisPoints": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "penaltyBasisPoints": { "$ref": "#/$defs/basisPoints" }
            }
          }
        }
      }
    }
  }
}
