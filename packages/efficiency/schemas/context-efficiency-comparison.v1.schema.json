{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/efficiency/context-efficiency-comparison.v1.schema.json",
  "title": "Agent Context Linter context-efficiency comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline",
    "candidate",
    "caveatCodes",
    "components",
    "profiles",
    "qualityClaim",
    "recordKind",
    "schemaVersion",
    "scope",
    "score",
    "semanticQualityPreservationClaim",
    "sourceCompatibility",
    "tokenizer"
  ],
  "properties": {
    "baseline": { "$ref": "#/$defs/side" },
    "candidate": { "$ref": "#/$defs/side" },
    "caveatCodes": {
      "const": [
        "quality-not-empirically-verified",
        "semantic-equivalence-not-proven",
        "static-analysis-only"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score"],
        "properties": {
          "id": {
            "enum": [
              "budgetFit",
              "scopePrecision",
              "nonRedundancy",
              "reachability",
              "instructionDensity",
              "crossAgentConsistency"
            ]
          },
          "score": { "$ref": "#/$defs/value" }
        }
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alwaysOnP50", "effectiveMaximum", "effectiveP50", "effectiveP95", "key"],
        "properties": {
          "alwaysOnP50": { "$ref": "#/$defs/value" },
          "effectiveMaximum": { "$ref": "#/$defs/value" },
          "effectiveP50": { "$ref": "#/$defs/value" },
          "effectiveP95": { "$ref": "#/$defs/value" },
          "key": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "qualityClaim": { "const": false },
    "recordKind": { "const": "agent-context-efficiency-comparison" },
    "schemaVersion": { "const": "1.0.0" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetPath"],
      "properties": {
        "kind": { "const": "repository" },
        "targetPath": { "type": "null" }
      }
    },
    "score": { "$ref": "#/$defs/value" },
    "semanticQualityPreservationClaim": { "const": false },
    "sourceCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationSha256",
        "profileIdentitySha256",
        "scoreSpecificationSha256",
        "scoreVersion"
      ],
      "properties": {
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "profileIdentitySha256": { "$ref": "#/$defs/sha256" },
        "scoreSpecificationSha256": { "$ref": "#/$defs/sha256" },
        "scoreVersion": { "$ref": "#/$defs/token" }
      }
    },
    "tokenizer": {
      "$ref": "https://schemas.agent-context-lint.dev/efficiency/tokenizer-identity.v1.schema.json"
    }
  },
  "$defs": {
    "natural": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nullableNatural": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/natural" }] },
    "nullableInteger": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/integer" }] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricsSha256", "recommendationCount", "score", "state"],
      "properties": {
        "metricsSha256": { "$ref": "#/$defs/sha256" },
        "recommendationCount": { "$ref": "#/$defs/natural" },
        "score": { "$ref": "#/$defs/nullableNatural" },
        "state": { "enum": ["complete", "partial", "unavailable"] }
      }
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9]+(?:[._+:/-][A-Za-z0-9]+)*$"
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate", "delta"],
      "properties": {
        "baseline": { "$ref": "#/$defs/nullableNatural" },
        "candidate": { "$ref": "#/$defs/nullableNatural" },
        "delta": { "$ref": "#/$defs/nullableInteger" }
      }
    }
  }
}
