{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/efficiency/context-efficiency-report.v1.schema.json",
  "title": "Agent Context Linter context-efficiency report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profiles",
    "qualityClaim",
    "recommendations",
    "recordKind",
    "schemaVersion",
    "scope",
    "score",
    "semanticQualityPreservationClaim",
    "source",
    "state",
    "tokenizer"
  ],
  "properties": {
    "profiles": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/profile" }
    },
    "qualityClaim": { "const": false },
    "recommendations": {
      "$ref": "https://schemas.agent-context-lint.dev/efficiency/context-efficiency-recommendations.v1.schema.json"
    },
    "recordKind": { "const": "agent-context-efficiency-report" },
    "schemaVersion": { "const": "1.0.0" },
    "scope": { "$ref": "#/$defs/scope" },
    "score": {
      "$ref": "https://schemas.agent-context-lint.dev/efficiency/context-efficiency-score.v1.schema.json"
    },
    "semanticQualityPreservationClaim": { "const": false },
    "source": { "$ref": "#/$defs/source" },
    "state": { "enum": ["complete", "partial", "unavailable"] },
    "tokenizer": {
      "$ref": "https://schemas.agent-context-lint.dev/efficiency/tokenizer-identity.v1.schema.json"
    }
  },
  "$defs": {
    "natural": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nullableStatistics": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/statistics" }]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alwaysOnTokens",
        "clientVersion",
        "completeSampleCount",
        "effectiveTokens",
        "key",
        "profileId",
        "profileVersion",
        "sampleCount",
        "samplingState",
        "samplingStrategy",
        "specSnapshotId",
        "state",
        "surfaceId"
      ],
      "properties": {
        "alwaysOnTokens": { "$ref": "#/$defs/nullableStatistics" },
        "clientVersion": { "type": ["string", "null"], "maxLength": 512 },
        "completeSampleCount": { "$ref": "#/$defs/natural" },
        "effectiveTokens": { "$ref": "#/$defs/nullableStatistics" },
        "key": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "profileId": { "$ref": "#/$defs/token" },
        "profileVersion": { "$ref": "#/$defs/token" },
        "sampleCount": { "$ref": "#/$defs/natural" },
        "samplingState": { "enum": ["complete", "partial"] },
        "samplingStrategy": { "enum": ["exhaustive", "stratified"] },
        "specSnapshotId": { "$ref": "#/$defs/token" },
        "state": { "enum": ["complete", "empty", "partial"] },
        "surfaceId": { "$ref": "#/$defs/token" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetPath"],
      "properties": {
        "kind": { "const": "repository" },
        "targetPath": { "type": "null" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationSha256",
        "metricsContractVersion",
        "metricsSha256",
        "recommendationsContractVersion",
        "scoreContractVersion",
        "scoreSpecificationSha256",
        "scoreVersion"
      ],
      "properties": {
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "metricsContractVersion": { "$ref": "#/$defs/token" },
        "metricsSha256": { "$ref": "#/$defs/sha256" },
        "recommendationsContractVersion": { "$ref": "#/$defs/token" },
        "scoreContractVersion": { "$ref": "#/$defs/token" },
        "scoreSpecificationSha256": { "$ref": "#/$defs/sha256" },
        "scoreVersion": { "$ref": "#/$defs/token" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum", "minimum", "p50", "p95"],
      "properties": {
        "maximum": { "$ref": "#/$defs/natural" },
        "minimum": { "$ref": "#/$defs/natural" },
        "p50": { "$ref": "#/$defs/natural" },
        "p95": { "$ref": "#/$defs/natural" }
      }
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9]+(?:[._+:/-][A-Za-z0-9]+)*$"
    }
  }
}
