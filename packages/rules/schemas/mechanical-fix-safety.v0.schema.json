  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "proof", "reason", "ruleId"],
      "properties": {
        "decision": {
          "enum": ["approved", "refused"]
        },
        "proof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
        },
        "reason": {
          "enum": [
            "approved-exact-unused-suppression",
            "ambiguous-or-subjective",
            "changes-policy-semantics",
            "multi-file-or-unsupported-operation",
            "profile-or-version-dependent",
            "security-sensitive",
            "standards-operation-required",
            "efficiency-recommendation-only",
            "source-token-not-proven"
          ]
        },
        "ruleId": {
          "type": "string",
          "pattern": "^ACL[1-5][0-9]{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "approved-exact-unused-suppression"
              },
              "ruleId": {
                "const": "ACL109"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "refused"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "const": "approved-exact-unused-suppression"
                }
              },
              "ruleId": {
                "not": {
                  "const": "ACL109"
                }
              }
            }
          }
        }
      ]
    }
  }
}
