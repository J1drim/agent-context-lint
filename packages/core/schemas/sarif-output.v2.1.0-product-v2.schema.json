{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/core/sarif-output.v2.1.0-product-v2.schema.json",
  "title": "Agent Context Linter SARIF 2.1.0 product subset v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "$schema", "runs"],
  "properties": {
    "version": { "const": "2.1.0" },
    "$schema": {
      "const": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9]+(?:[._:/-][A-Za-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "$ref": "#/$defs/text" } }
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 4096,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "physicalLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactLocation", "region"],
      "properties": {
        "artifactLocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri"],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+(?:/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+)*$"
            }
          }
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startLine", "startColumn", "endLine", "endColumn"],
          "properties": {
            "startLine": { "type": "integer", "minimum": 1 },
            "startColumn": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 },
            "endColumn": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalLocation"],
      "properties": { "physicalLocation": { "$ref": "#/$defs/physicalLocation" } }
    },
    "relatedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "physicalLocation", "message"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 128 },
        "physicalLocation": { "$ref": "#/$defs/physicalLocation" },
        "message": { "$ref": "#/$defs/message" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shortDescription",
        "fullDescription",
        "helpUri",
        "help",
        "defaultConfiguration",
        "properties"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "shortDescription": { "$ref": "#/$defs/message" },
        "fullDescription": { "$ref": "#/$defs/message" },
        "helpUri": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://" },
        "help": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "markdown"],
          "properties": {
            "text": { "$ref": "#/$defs/text" },
            "markdown": { "$ref": "#/$defs/text" }
          }
        },
        "defaultConfiguration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": { "level": { "enum": ["error", "warning", "note"] } }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tags",
            "problem.severity",
            "agentContextCategory",
            "agentContextFixSafety",
            "agentContextOwner",
            "agentContextPrecisionStatus"
          ],
          "properties": {
            "tags": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            },
            "problem.severity": { "enum": ["error", "warning", "recommendation"] },
            "agentContextCategory": { "$ref": "#/$defs/identifier" },
            "agentContextFixSafety": { "$ref": "#/$defs/identifier" },
            "agentContextOwner": { "$ref": "#/$defs/text" },
            "agentContextPrecisionStatus": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "provenanceIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleIndex",
        "level",
        "message",
        "locations",
        "relatedLocations",
        "partialFingerprints",
        "properties"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identifier" },
        "ruleIndex": { "type": "integer", "minimum": 0 },
        "level": { "enum": ["error", "warning", "note"] },
        "message": { "$ref": "#/$defs/message" },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "relatedLocations": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relatedLocation" }
        },
        "partialFingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primaryLocationLineHash", "agentContextPath/v1", "agentContextSemantic/v1"],
          "properties": {
            "primaryLocationLineHash": {
              "type": "string",
              "minLength": 3,
              "maxLength": 4096,
              "pattern": "^[a-f0-9]+:[1-9][0-9]*$"
            },
            "agentContextPath/v1": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "agentContextSemantic/v1": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentContextRuleVersion", "profileIds", "surfaceIds", "specSnapshotIds"],
          "properties": {
            "agentContextRuleVersion": { "$ref": "#/$defs/version" },
            "profileIds": { "$ref": "#/$defs/provenanceIds" },
            "surfaceIds": { "$ref": "#/$defs/provenanceIds" },
            "specSnapshotIds": { "$ref": "#/$defs/provenanceIds" }
          }
        }
      }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileVersion", "clientVersion"],
      "properties": {
        "profileVersion": { "$ref": "#/$defs/version" },
        "clientVersion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "results", "properties"],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver"],
          "properties": {
            "driver": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "semanticVersion", "informationUri", "rules"],
              "properties": {
                "name": { "const": "Agent Context Linter" },
                "semanticVersion": { "$ref": "#/$defs/version" },
                "informationUri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^https://"
                },
                "rules": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/rule" } }
              }
            }
          }
        },
        "results": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/result" } },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentContextSchemaVersion", "profileVersions"],
          "properties": {
            "agentContextSchemaVersion": { "const": "2.0.0" },
            "profileVersions": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "$ref": "#/$defs/profileIdentity" }
            }
          }
        }
      }
    }
  }
}
