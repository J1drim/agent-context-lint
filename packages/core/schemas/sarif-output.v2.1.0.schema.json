{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/core/sarif-output.v2.1.0.schema.json",
  "title": "Agent Context Linter supported SARIF 2.1.0 subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "$schema", "runs"],
  "properties": {
    "version": { "const": "2.1.0" },
    "$schema": {
      "const": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9]+(?:[._:/-][A-Za-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 4096,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalLocation"],
      "properties": {
        "physicalLocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactLocation", "region"],
          "properties": {
            "artifactLocation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uri"],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+(?:/(?:[A-Za-z0-9._~-]|%[0-9A-F]{2})+)*$"
                }
              }
            },
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startLine", "startColumn", "endLine", "endColumn"],
              "properties": {
                "startLine": { "type": "integer", "minimum": 1 },
                "startColumn": { "type": "integer", "minimum": 1 },
                "endLine": { "type": "integer", "minimum": 1 },
                "endColumn": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "shortDescription", "defaultConfiguration"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "shortDescription": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "$ref": "#/$defs/text" } }
        },
        "defaultConfiguration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": { "level": { "enum": ["error", "warning", "note"] } }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleIndex",
        "level",
        "message",
        "locations",
        "relatedLocations",
        "partialFingerprints"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identifier" },
        "ruleIndex": { "type": "integer", "minimum": 0 },
        "level": { "enum": ["error", "warning", "note"] },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "$ref": "#/$defs/text" } }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/location" }
        },
        "relatedLocations": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/location" }
        },
        "partialFingerprints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1024,
            "pattern": "^[A-Za-z][A-Za-z0-9./-]*/v[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "results", "properties"],
      "properties": {
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver"],
          "properties": {
            "driver": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "semanticVersion", "informationUri", "rules"],
              "properties": {
                "name": { "const": "Agent Context Linter" },
                "semanticVersion": { "$ref": "#/$defs/version" },
                "informationUri": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^https://"
                },
                "rules": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": { "$ref": "#/$defs/rule" }
                }
              }
            }
          }
        },
        "results": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/result" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentContextSchemaVersion", "profileVersions"],
          "properties": {
            "agentContextSchemaVersion": { "const": "1.0.0" },
            "profileVersions": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["profileVersion", "clientVersion"],
                "properties": {
                  "profileVersion": { "$ref": "#/$defs/version" },
                  "clientVersion": {
                    "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
