{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/core/diagnostic-baseline.v1.schema.json",
  "title": "Agent Context Linter diagnostic baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "schemaVersion",
    "diagnosticContractVersion",
    "engineVersion",
    "fingerprintMethods",
    "createdAt",
    "expiresAt",
    "sourceRevision",
    "profileVersions",
    "entries"
  ],
  "properties": {
    "recordKind": { "const": "agent-context-baseline-output" },
    "schemaVersion": { "const": "1.0.0" },
    "diagnosticContractVersion": { "const": "0.1.0" },
    "engineVersion": { "$ref": "#/$defs/version" },
    "fingerprintMethods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "semantic"],
      "properties": {
        "path": { "const": "agent-context-lint/path/v1" },
        "semantic": { "const": "agent-context-lint/semantic/v1" }
      }
    },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "expiresAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }] },
    "sourceRevision": { "$ref": "#/$defs/digest" },
    "profileVersions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100000,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/profileIdentity" }
    },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9]+(?:[._:/-][A-Za-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 4096,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "identifiers": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "profileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileVersion", "clientVersion", "surfaceIds", "specSnapshotIds"],
      "properties": {
        "profileVersion": { "$ref": "#/$defs/version" },
        "clientVersion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "surfaceIds": { "$ref": "#/$defs/identifiers" },
        "specSnapshotIds": { "$ref": "#/$defs/identifiers" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "severity",
        "path",
        "semanticFingerprint",
        "pathFingerprint",
        "provenanceFingerprint",
        "profileIds",
        "surfaceIds",
        "specSnapshotIds",
        "firstSeenAt",
        "expiresAt"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identifier" },
        "ruleVersion": { "$ref": "#/$defs/version" },
        "severity": { "enum": ["error", "warning", "info"] },
        "path": { "$ref": "#/$defs/text" },
        "semanticFingerprint": { "$ref": "#/$defs/digest" },
        "pathFingerprint": { "$ref": "#/$defs/digest" },
        "provenanceFingerprint": { "$ref": "#/$defs/digest" },
        "profileIds": { "$ref": "#/$defs/identifiers" },
        "surfaceIds": { "$ref": "#/$defs/identifiers" },
        "specSnapshotIds": { "$ref": "#/$defs/identifiers" },
        "firstSeenAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }] }
      }
    }
  }
}
