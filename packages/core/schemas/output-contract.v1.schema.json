{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-context-lint.dev/core/output-contract.v1.schema.json",
  "title": "Agent Context Linter native output contracts v1",
  "oneOf": [
    { "$ref": "#/$defs/terminal" },
    { "$ref": "#/$defs/scan" },
    { "$ref": "#/$defs/efficiency" },
    { "$ref": "#/$defs/standards" },
    { "$ref": "#/$defs/baseline" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9]+(?:[._:/-][A-Za-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 4096,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "digest": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "dateTime": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "infos", "suppressed", "exitCode"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "exitCode": { "enum": [0, 1, 2] }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordKind", "schemaVersion", "colorMode", "width", "lines", "summary"],
      "properties": {
        "recordKind": { "const": "agent-context-terminal-output" },
        "schemaVersion": { "const": "1.0.0" },
        "colorMode": { "enum": ["ansi", "never"] },
        "width": { "type": "integer", "minimum": 20, "maximum": 1000 },
        "lines": {
          "type": "array",
          "maxItems": 100000,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "schemaVersion",
        "profileVersions",
        "failureThreshold",
        "diagnostics",
        "summary"
      ],
      "properties": {
        "recordKind": { "const": "agent-context-scan-output" },
        "schemaVersion": { "const": "1.0.0" },
        "profileVersions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profileVersion", "clientVersion"],
            "properties": {
              "profileVersion": { "$ref": "#/$defs/version" },
              "clientVersion": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
              }
            }
          }
        },
        "failureThreshold": { "enum": ["error", "warning", "never"] },
        "diagnostics": {
          "$ref": "diagnostic-contract.v0.schema.json"
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "schemaVersion",
        "profileId",
        "profileVersion",
        "clientVersion",
        "surfaceId",
        "specSnapshotId",
        "tokenizer",
        "sampleCount",
        "tokenStatistics",
        "score",
        "recommendations"
      ],
      "properties": {
        "recordKind": { "const": "agent-context-efficiency-output" },
        "schemaVersion": { "const": "1.0.0" },
        "profileId": { "$ref": "#/$defs/identifier" },
        "profileVersion": { "$ref": "#/$defs/version" },
        "clientVersion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "surfaceId": { "$ref": "#/$defs/identifier" },
        "specSnapshotId": { "$ref": "#/$defs/identifier" },
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "measurement"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "$ref": "#/$defs/text" },
            "measurement": { "enum": ["exact", "estimate"] }
          }
        },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "tokenStatistics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "median", "p95", "maximum"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "median": { "type": "integer", "minimum": 0 },
            "p95": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "value", "grade"],
          "properties": {
            "version": { "$ref": "#/$defs/version" },
            "value": { "type": "number", "minimum": 0, "maximum": 100 },
            "grade": { "enum": ["A", "B", "C", "D", "F"] }
          }
        },
        "recommendations": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "path",
              "baselineTokens",
              "projectedTokens",
              "confidence",
              "caveats",
              "benchmarkStatus"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "title": { "$ref": "#/$defs/text" },
              "path": { "$ref": "#/$defs/text" },
              "baselineTokens": { "type": "integer", "minimum": 0 },
              "projectedTokens": { "type": "integer", "minimum": 0 },
              "confidence": { "enum": ["high", "medium", "low"] },
              "caveats": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/text" }
              },
              "benchmarkStatus": { "enum": ["not-run", "passed", "failed"] }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "version", "digest", "retrievedAt"],
      "properties": {
        "channel": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" },
        "retrievedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "schemaVersion",
        "mode",
        "channel",
        "bundled",
        "locked",
        "cachedLatest",
        "activation",
        "freshness",
        "problems"
      ],
      "properties": {
        "recordKind": { "const": "agent-context-standards-output" },
        "schemaVersion": { "const": "1.0.0" },
        "mode": { "enum": ["status", "check", "update-dry-run", "update"] },
        "channel": { "$ref": "#/$defs/identifier" },
        "bundled": { "$ref": "#/$defs/artifact" },
        "locked": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "cachedLatest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "activation": { "enum": ["bundled", "locked"] },
        "freshness": { "enum": ["current", "update-available", "offline-unknown"] },
        "problems": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "schemaVersion",
        "diagnosticContractVersion",
        "engineVersion",
        "fingerprintMethods",
        "createdAt",
        "expiresAt",
        "sourceRevision",
        "profileVersions",
        "entries"
      ],
      "properties": {
        "recordKind": { "const": "agent-context-baseline-output" },
        "schemaVersion": { "const": "1.0.0" },
        "diagnosticContractVersion": { "const": "0.1.0" },
        "engineVersion": { "$ref": "#/$defs/version" },
        "fingerprintMethods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "semantic"],
          "properties": {
            "path": { "const": "agent-context-lint/path/v1" },
            "semantic": { "const": "agent-context-lint/semantic/v1" }
          }
        },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "expiresAt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }]
        },
        "sourceRevision": { "$ref": "#/$defs/digest" },
        "profileVersions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profileVersion", "clientVersion", "surfaceIds", "specSnapshotIds"],
            "properties": {
              "profileVersion": { "$ref": "#/$defs/version" },
              "clientVersion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
              "surfaceIds": {
                "type": "array",
                "maxItems": 100000,
                "items": { "$ref": "#/$defs/identifier" }
              },
              "specSnapshotIds": {
                "type": "array",
                "maxItems": 100000,
                "items": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "ruleVersion",
              "severity",
              "path",
              "semanticFingerprint",
              "pathFingerprint",
              "provenanceFingerprint",
              "profileIds",
              "surfaceIds",
              "specSnapshotIds",
              "firstSeenAt",
              "expiresAt"
            ],
            "properties": {
              "ruleId": { "$ref": "#/$defs/identifier" },
              "ruleVersion": { "$ref": "#/$defs/version" },
              "severity": { "enum": ["error", "warning", "info"] },
              "path": { "$ref": "#/$defs/text" },
              "semanticFingerprint": { "$ref": "#/$defs/digest" },
              "pathFingerprint": { "$ref": "#/$defs/digest" },
              "provenanceFingerprint": { "$ref": "#/$defs/digest" },
              "profileIds": {
                "type": "array",
                "maxItems": 100000,
                "items": { "$ref": "#/$defs/identifier" }
              },
              "surfaceIds": {
                "type": "array",
                "maxItems": 100000,
                "items": { "$ref": "#/$defs/identifier" }
              },
              "specSnapshotIds": {
                "type": "array",
                "maxItems": 100000,
                "items": { "$ref": "#/$defs/identifier" }
              },
              "firstSeenAt": { "$ref": "#/$defs/dateTime" },
              "expiresAt": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dateTime" }]
              }
            }
          }
        }
      }
    }
  }
}
