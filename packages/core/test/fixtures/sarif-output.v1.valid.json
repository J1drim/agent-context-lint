{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Agent Context Linter",
          "semanticVersion": "1.0.0",
          "informationUri": "https://agent-context-lint.dev",
          "rules": [
            {
              "id": "ACL100",
              "name": "valid-agent-context",
              "shortDescription": { "text": "Validate agent context" },
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ACL100",
          "ruleIndex": 0,
          "level": "warning",
          "message": { "text": "Invalid agent context" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "AGENTS.md" },
                "region": { "startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 5 }
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "AGENTS.md" },
                "region": { "startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 5 }
              }
            }
          ],
          "partialFingerprints": {
            "agentContextPath/v1": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "agentContextSemantic/v1": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        }
      ],
      "properties": {
        "agentContextSchemaVersion": "1.0.0",
        "profileVersions": {
          "codex-cli": { "profileVersion": "1.0.0", "clientVersion": "0.146.0" }
        }
      }
    }
  ]
}
