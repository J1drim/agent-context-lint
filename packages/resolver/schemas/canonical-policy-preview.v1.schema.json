{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-context-lint.dev/schemas/canonical-policy-preview.v1.schema.json",
  "title": "Agent Context Linter canonical-policy preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "contractVersion",
    "policyId",
    "canonical",
    "targets",
    "patch",
    "patchSha256"
  ],
  "properties": {
    "recordKind": { "const": "agent-context-canonical-policy-preview" },
    "contractVersion": { "const": "1.0.0" },
    "policyId": { "$ref": "#/$defs/identifier" },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatId", "path", "profile", "sha256"],
      "properties": {
        "formatId": { "const": "agents-markdown" },
        "path": { "$ref": "#/$defs/path" },
        "profile": { "$ref": "#/$defs/profile" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/target" },
            { "type": "object", "properties": { "targetId": { "const": "claude-code" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/target" },
            { "type": "object", "properties": { "targetId": { "const": "copilot" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/target" },
            { "type": "object", "properties": { "targetId": { "const": "cursor-agent" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/target" },
            { "type": "object", "properties": { "targetId": { "const": "gemini-cli" } } }
          ]
        }
      ],
      "items": false
    },
    "patch": { "type": "string", "maxLength": 4194304 },
    "patchSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^(?:\\.|[^/\\\\]+(?:/[^/\\\\]+)*)$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefs", "profileId", "specSnapshotId", "surfaceId", "uncertainty"],
      "properties": {
        "evidenceRefs": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "specSnapshotId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "surfaceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "uncertainty": { "enum": ["conditional", "contradiction", "known", "unknown"] }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "schemaVersion",
        "generatorVersion",
        "targetId",
        "policyId",
        "path",
        "formatId",
        "canonicalSha256",
        "generatedSha256",
        "content"
      ],
      "properties": {
        "recordKind": { "const": "agent-context-canonical-policy-base" },
        "schemaVersion": { "const": "1.0.0" },
        "generatorVersion": { "const": "1.0.0" },
        "targetId": { "enum": ["claude-code", "copilot", "cursor-agent", "gemini-cli"] },
        "policyId": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/path" },
        "formatId": {
          "enum": [
            "claude-memory-markdown",
            "claude-rule-markdown",
            "copilot-path-instructions",
            "copilot-repository-markdown",
            "cursor-mdc",
            "gemini-context-markdown"
          ]
        },
        "canonicalSha256": { "$ref": "#/$defs/sha256" },
        "generatedSha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string", "maxLength": 1048576 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "path",
        "formatId",
        "profiles",
        "semanticEquivalenceClaimed",
        "state",
        "application",
        "mergeState",
        "reason",
        "beforeSha256",
        "afterSha256",
        "nextBase",
        "patch",
        "patchSha256"
      ],
      "properties": {
        "targetId": { "enum": ["claude-code", "copilot", "cursor-agent", "gemini-cli"] },
        "path": { "$ref": "#/$defs/path" },
        "formatId": {
          "enum": [
            "claude-memory-markdown",
            "claude-rule-markdown",
            "copilot-path-instructions",
            "copilot-repository-markdown",
            "cursor-mdc",
            "gemini-context-markdown"
          ]
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/profile" }
        },
        "semanticEquivalenceClaimed": { "const": false },
        "state": { "enum": ["preview-only", "ready", "refused", "unchanged"] },
        "application": {
          "enum": ["existing-file-atomic", "not-applicable", "preview-only"]
        },
        "mergeState": {
          "enum": [
            "already-current",
            "clean-update",
            "create-preview",
            "hand-edit-conflict",
            "malformed-current",
            "malformed-prior-base",
            "missing-current",
            "unrepresentable",
            "untracked-existing"
          ]
        },
        "reason": { "type": ["string", "null"], "maxLength": 2048 },
        "beforeSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "afterSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "nextBase": {
          "anyOf": [{ "$ref": "#/$defs/base" }, { "type": "null" }]
        },
        "patch": { "type": "string", "maxLength": 4194304 },
        "patchSha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": {
            "properties": {
              "application": { "const": "existing-file-atomic" },
              "mergeState": { "const": "clean-update" },
              "nextBase": { "$ref": "#/$defs/base" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "preview-only" } }, "required": ["state"] },
          "then": {
            "properties": {
              "application": { "const": "preview-only" },
              "mergeState": { "const": "create-preview" },
              "nextBase": { "$ref": "#/$defs/base" }
            }
          }
        },
        {
          "if": {
            "properties": { "mergeState": { "const": "unrepresentable" } },
            "required": ["mergeState"]
          },
          "then": {
            "properties": {
              "afterSha256": { "type": "null" },
              "application": { "const": "not-applicable" },
              "nextBase": { "type": "null" },
              "state": { "const": "refused" }
            }
          }
        }
      ]
    }
  }
}
